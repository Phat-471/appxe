<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Glowing Safety Shield Outer Border -->
    <path
        android:pathData="M54,16 L84,28 L84,58 C84,76 54,92 54,92 C54,92 24,76 24,58 L24,28 Z"
        android:strokeWidth="3.2"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="16"
                android:endX="84"
                android:endY="92"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#1E88E5" android:offset="0.5" />
                <item android:color="#DC2626" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Shield Inner Background Glow -->
    <path
        android:pathData="M54,20 L80,30 L80,57 C80,72 54,86 54,86 C54,86 28,72 28,57 L28,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="20"
                android:endX="54"
                android:endY="86"
                android:type="linear">
                <item android:color="#1E293B" android:offset="0.0" />
                <item android:color="#0F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Speedometer Arc Gauge -->
    <path
        android:pathData="M37,65 A20,20 0 1,1 71,65"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="37"
                android:startY="65"
                android:endX="71"
                android:endY="65"
                android:type="linear">
                <item android:color="#10B981" android:offset="0.0" />
                <item android:color="#F59E0B" android:offset="0.6" />
                <item android:color="#EF4444" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Speed Limit Red Ring Badge (Center-Top) -->
    <path
        android:pathData="M54,34 A8,8 0 1,1 53.99,34"
        android:fillColor="#FFFFFF"
        android:strokeColor="#DC2626"
        android:strokeWidth="2.5" />

    <!-- 5. Speed Needle / GPS Navigation Arrow -->
    <path
        android:pathData="M54,42 L66,62 L54,56 L42,62 Z"
        android:fillColor="#38BDF8"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineJoin="round" />

    <!-- 6. Radar Pulse Center Core -->
    <path
        android:pathData="M54,56 A3.5,3.5 0 1,1 53.99,56"
        android:fillColor="#FFFFFF" />

    <!-- 7. Camera Lens Aperture Ring -->
    <path
        android:pathData="M54,34 A3.5,3.5 0 1,1 53.99,34"
        android:fillColor="#DC2626" />

</vector>
